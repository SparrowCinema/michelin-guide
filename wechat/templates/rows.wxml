<template name="rows"><view wx:for="{{groups}}" wx:for-item="country" wx:key="name"><view class="ctry">{{country.name}}<text class="small">{{country.en}} · {{country.continent}} · {{country.count}} 家</text></view><view class="city" wx:for="{{country.cities}}" wx:for-item="city" wx:key="name"><view class="h3">{{city.name}}<text class="small">{{city.rows.length}} 家</text></view><view class="rl"><view class="restaurant-row" wx:for="{{city.rows}}" wx:for-item="r" wx:key="id"><view class="lv {{r.badgeClass}}">{{r.badge}}</view><view class="nm"><view class="t" data-id="{{r.id}}" bindtap="open">{{r.name}}<text wx:if="{{r.isNew}}" class="tag">新上榜</text><text wx:if="{{r.up}}" class="tag">升星</text><text wx:if="{{r.green}}" class="tag g">绿星</text></view><view class="orig" wx:if="{{r.name!==r.original}}">{{r.original}}</view><view class="meta">{{r.cuisine}}<text wx:if="{{r.priceText}}"> · {{r.priceText}}</text><text wx:if="{{r.km}}"> · {{r.km}} 公里</text></view><view class="meta" wx:if="{{r.pearl}}">黑珍珠 {{r.pearl}} 钻</view><view class="links"><view class="action fav {{r.wanted?'wanted':''}}" data-id="{{r.id}}" bindtap="rowWant"><text>♡</text> 想去</view><view class="action fav {{r.visited?'visited':''}}" data-id="{{r.id}}" bindtap="rowVisit"><text>✧</text> 去过<text wx:if="{{r.myScore}}"> ★{{r.myScore}}</text></view><view class="action quiet" data-id="{{r.id}}" bindtap="navigate">↗ 导航</view></view></view></view></view></view></view></template>