.native-tabbar{position:fixed;left:0;right:0;bottom:0;display:flex;height:58px;padding-bottom:env(safe-area-inset-bottom);background:#faf8f6f5;border-top:1px solid #e8e1dd;z-index:1000}.native-tab{display:flex;flex:1;align-items:center;justify-content:center;flex-direction:column;gap:4px;color:#7a716e;font-size:11px}.native-tab image{width:22px;height:22px}.native-tab.active{color:#b3261e}.theme-dark{background:#161312f5;border-color:#352f2d}.theme-dark .native-tab{color:#a39893}.theme-dark .native-tab.active{color:#ef6b60}