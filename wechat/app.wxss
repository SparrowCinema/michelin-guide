/* Restaurant sheet, official imagery and the website's meal log. */
.detail-shell{padding:0 20px 28px;background:var(--surface);min-height:100vh}.detail-grab{height:44px;position:sticky;top:0;z-index:40;background:var(--surface);display:flex;align-items:center;justify-content:center}.grabber{height:4px;width:34px;background:var(--line);border-radius:99px}.close{position:absolute;right:0;top:7px;font-size:13px;border:1px solid var(--line);border-radius:99px;padding:4px 12px}.detail-hero{position:relative;overflow:hidden;box-sizing:border-box;min-height:265px;padding:30px 24px 24px;border-radius:14px;background:radial-gradient(ellipse at 85% 0,#c5a56c24,transparent 65%),var(--hover);display:flex;align-items:flex-end;margin:4px 0 18px}.detail-photo{position:absolute;inset:0;width:100%;height:100%}.detail-hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,#10100d99,transparent 100%),linear-gradient(180deg,#10100d08 0%,#10100d66 34%,#10100de8 100%)}.detail-hero-content{position:relative;width:100%;min-width:0}.detail-hero-kicker{font-size:9px;letter-spacing:.16em;color:var(--muted)}.detail-title{font:800 clamp(25px,7vw,34px)/1.2 var(--display);margin:10px 0 6px;overflow-wrap:anywhere}.detail-origin{font-size:12px;color:var(--muted);margin:0 0 9px}.detail-location{margin:6px 0;font-size:12px}.detail-hero .lv{display:inline-block;min-width:58px}.has-photo .detail-title,.has-photo .detail-origin,.has-photo .detail-hero-kicker,.has-photo .detail-location{color:#fff8eb;text-shadow:0 1px 8px #0006}.has-photo .lv{color:#ffe6a8;background:transparent;border:0;padding:0;font-size:18px;width:auto;text-shadow:0 1px 4px #0009}.detail-photo-credit{display:flex;justify-content:space-between;flex-wrap:wrap;gap:4px 14px;font-size:9px;color:var(--muted);margin:-8px 2px 18px}.detail-facts{display:grid;grid-template-columns:62px 1fr;gap:10px;margin:22px 0;font-size:14px}.dt{color:var(--muted)}.address-zh{font-size:14px;line-height:1.8}.address-method{font-size:10px;color:var(--muted);margin:4px 0 8px}.address-en{font-size:12px;line-height:1.65;color:var(--muted);padding-top:6px;border-top:1px dashed var(--line)}.address-tools{display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px;margin-top:10px;font-size:11px;color:var(--red)}.detail-intro{margin:18px 0 6px;padding:18px 18px 14px;border-radius:16px;background:linear-gradient(160deg,var(--red-soft),var(--surface) 70%);border:1px solid var(--line)}.intro-zh{font-size:14px;line-height:1.9;margin:12px 0}.intro-en{font-size:12px;line-height:1.75;color:var(--muted)}.intro-review{font-size:12px;color:var(--red);margin-top:12px}.detail-actions{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0}.detail-section{border-top:1px solid var(--line);margin-top:20px;padding-top:14px}.section-summary{display:flex;align-items:center;gap:8px;font:600 18px var(--display);padding:8px 0 14px}.section-summary>text{margin-left:auto;font:11px var(--body);color:var(--muted)}.price-note{background:var(--hover);border-radius:10px;padding:14px;font-size:13px}.timeline{display:flex;gap:8px;flex-wrap:wrap}.timeline>view{background:var(--hover);border-radius:8px;padding:10px;font-size:12px;flex:1;min-width:40px;color:var(--muted)}.timeline .bold{display:block;font-size:14px;margin-top:4px;color:var(--fg)}.meal-summary{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:12px 0 18px}.meal-summary .serif{font-size:19px;font-weight:600}.meal-card{display:flex;gap:10px;align-items:center;border:1px solid var(--line);border-radius:14px;padding:16px 12px;background:var(--surface);margin-bottom:12px}.meal-date{width:54px;flex-shrink:0;display:flex;flex-direction:column;align-items:center;color:var(--muted);font-size:10px}.meal-date text:first-child{font:700 23px var(--display);color:var(--fg)}.meal-main{flex:1;min-width:0}.meal-index{font-size:10px;color:var(--muted)}.meal-stars{color:var(--red);font-size:15px;font-weight:600;margin:5px 0}.meal-note{font-size:13px;line-height:1.65;white-space:pre-line;opacity:.82}.meal-edit{font-size:12px;padding:6px 14px;border:1px solid var(--line);border-radius:999px}.meal-editor{padding:16px 14px;border-radius:16px;background:var(--surface);border:1px solid var(--line);box-shadow:0 10px 28px #28141414;margin-top:12px}.meal-editor-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding-bottom:10px;border-bottom:1px solid var(--line);font:600 17px var(--display)}.rating-field{font-size:12px;color:var(--muted);margin-top:16px}.star-rating{display:flex;margin:4px 0;color:var(--red)}.star{position:relative;width:37px;height:42px;font-size:34px;line-height:42px}.outline{color:var(--line)}.fill{position:absolute;top:0;left:0;height:100%;overflow:hidden;color:var(--red);white-space:nowrap}.half{position:absolute;top:0;bottom:0;width:50%;z-index:2}.left{left:0}.right{right:0}.rating-caption{display:flex;align-items:center;gap:18px;font-size:11px;color:var(--muted);min-height:20px}.rating-caption text:last-child{text-decoration:underline}.form-label{font-size:12px;color:var(--muted);margin-top:16px}.field{box-sizing:border-box;width:100%;padding:10px;margin:6px 0 12px;border:1px solid var(--line);border-radius:8px;background:var(--surface);color:var(--fg);font-size:15px}.visit-feedback{font-size:11px;color:var(--muted);margin:8px 0 16px}.visit-actions{display:flex;align-items:center;justify-content:flex-end;gap:16px}.visit-actions .btn{min-width:120px}textarea.field{height:100px}
@media(max-width:350px){.pp-cover{width:225px;min-height:344px}.pp-cover-publisher{font-size:12px}.pp-page{padding:17px 15px}.pp-stamp-grid{gap:20px 10px}.seg>view{padding:5px 9px}.action{padding:0 8px}.links{gap:4px}}
.pp-landmark image{width:62px;height:46px}.recap-range{display:flex;gap:4px;padding:4px;background:var(--hover);border-radius:10px;margin:14px 0}.recap-range>view{flex:1;border-radius:7px;padding:9px 6px;text-align:center;font-size:13px;color:var(--muted)}.recap-range .active{background:#782e3b;color:#fff7eb}.recap-preview{width:100%;height:auto}.share-actions{display:flex;justify-content:flex-end;gap:12px;margin:20px 0}
/* The website opens as a scaled two-page physical spread, including on phones. */
.pp-spread-stage{position:relative;width:100%;max-width:840px;margin:auto;perspective:1500px}.pp-book{display:flex;box-sizing:border-box;width:840px;height:600px;transform-origin:top left;border-radius:5px 12px 12px 5px;box-shadow:0 3px 0 #d5c7ac,0 6px 0 -1px #b8a78a,0 16px 28px -16px #30201980}.pp-book .pp-page{width:420px;flex-shrink:0;height:600px;min-height:600px;padding:22px 25px 18px;overflow:hidden;background-color:#f6f0e2}.pp-book .pp-identity{border-right:1px solid #b5a283;border-radius:5px 0 0 5px;box-shadow:inset -24px 0 28px -22px #74604390}.pp-book .pp-visas{border-radius:0 12px 12px 0;box-shadow:inset 24px 0 28px -22px #74604390}.pp-book .pp-portrait{width:76px;height:100px}.pp-book .pp-stamp-grid{gap:22px 18px;padding:14px 0 18px}.pp-book .pp-stamp{width:158px;height:158px;padding:12px 9px}.pp-book .pp-identity-head .h4{font-size:24px}.pp-book .pp-stamp-top{font-size:5px}.pp-book .pp-intro{margin:22px 0}.pp-book .pp-signature{margin-top:auto}
