<view class="wrap"><view class="title">全球美食名录</view><input class="field" placeholder="搜索餐厅 / 城市 / 国家" bindinput="search" value="{{keyword}}"/><view class="sub">当前为可运行开发版；完整名录需接入线上数据服务</view><block wx:for="{{items}}" wx:key="id"><view class="card" data-id="{{item.id}}" bindtap="open"><view>{{item.name}}</view><view class="sub">{{item.city}} · {{item.rating}}</view></view></block></view>