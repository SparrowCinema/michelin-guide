<view class="app theme-{{theme}}" wx:if="{{restaurant}}"><view class="detail-shell"><view class="detail-grab" bindtouchstart="touchStart" bindtouchend="touchEnd"><view class="grabber"/><view class="close" bindtap="close">关闭</view></view><view class="detail-body"><view class="detail-hero {{restaurant.photo?'has-photo':''}}"><image wx:if="{{restaurant.photo}}" src="{{restaurant.photo}}" class="detail-photo" mode="aspectFill" binderror="photoError"/><view class="detail-hero-shade" wx:if="{{restaurant.photo}}"/><view class="detail-hero-content"><text class="detail-hero-kicker">THE MICHELIN SELECTION</text><view class="detail-title">{{restaurant.name}}</view><view class="detail-origin" wx:if="{{restaurant.name!==restaurant.original}}">{{restaurant.original}}</view><view class="detail-location">{{restaurant.country}} · {{restaurant.city}}</view><view class="lv {{restaurant.badgeClass}}">{{restaurant.badge}}</view><text class="tag g" wx:if="{{restaurant.green}}">绿星</text></view></view><view class="detail-photo-credit" wx:if="{{restaurant.photo}}">图片来源：米其林指南 ↗<text>摄影版权归原权利人</text></view><view class="detail-facts"><view class="dt">菜系</view><view>{{restaurant.cuisine}}</view><view class="dt">地址</view><view class="address-display"><view class="address-zh">{{addressZh}}</view><view class="address-method">{{addressMethod}}</view><view class="address-en">EN {{restaurant.addressOriginal}}</view><view class="address-tools"><text bindtap="navigate">↗ 导航</text><text data-key="address" bindtap="copy">复制地址 Copy</text></view></view><view class="dt">价位</view><view>{{restaurant.priceText}} · 当地价位</view></view><view class="detail-intro"><view class="eyebrow">ABOUT THIS TABLE</view><view class="h3">关于这家餐厅</view><view class="intro-zh">{{introZh}}</view><view class="intro-en">{{introEn}}</view><view class="intro-review" data-key="source" bindtap="copy">米其林官方介绍 ↗</view></view><view class="detail-actions"><view class="action" data-key="source" bindtap="copy">◎ 米其林页面</view><view class="action dark" bindtap="navigate">↗ 导航</view><view wx:if="{{restaurant.website}}" class="action" data-key="website" bindtap="copy">▢ 官网 / 查询预约</view><view class="action quiet" data-key="link" bindtap="copy">复制餐厅链接</view></view><view class="links"><view class="action {{wanted?'wanted':''}}" bindtap="want">♡ 想去</view><view class="action" bindtap="addTrip">＋ 加入旅行</view></view><view class="detail-section" wx:if="{{restaurant.price.length}}"><view class="section-summary" data-key="pricesOpen" bindtap="toggle">{{pricesOpen?'▾':'▸'}} 参考消费</view><view class="price-note" wx:if="{{pricesOpen}}"><view wx:for="{{restaurant.price}}" wx:key="source"><view class="bold">{{item.meal}} · {{item.currency}} {{item.min}}—{{item.max}}</view><view>{{item.basis}} · {{item.includes}}</view><view class="sub">核实于 {{item.checked}}</view></view></view></view><view class="detail-section" wx:if="{{history.length>1}}"><view class="section-summary" data-key="historyOpen" bindtap="toggle">{{historyOpen?'▾':'▸'}} 历年评级<text>{{history[0].year}}—2026</text></view><view wx:if="{{historyOpen}}"><view class="timeline"><view wx:for="{{history}}" wx:key="year">{{item.year}}<text class="bold">{{item.label}}</text></view></view><view class="note">依据历年保存的名单整理。</view></view></view><view class="detail-section"><view class="section-summary" data-key="recordOpen" bindtap="toggle">{{recordOpen?'▾':'▸'}} {{visited?'我的用餐记录':'记录一次用餐'}}<text>评分 · 日期 · 笔记</text></view><view wx:if="{{recordOpen}}"><view class="meal-summary" wx:if="{{meals.length}}"><text class="serif">已留下 {{meals.length}} 次味觉记忆</text><view class="action" bindtap="newMeal">＋ 再记一餐</view></view><view class="meal-timeline" wx:if="{{!editing}}"><view class="meal-card" wx:for="{{meals}}" wx:key="id"><view class="meal-date"><text>{{item.monthDay}}</text><text>{{item.year}}</text></view><view class="meal-main"><view class="meal-index">第 {{index+1}} 次用餐</view><view class="meal-stars">{{item.score||item.rating||'未评分'}}<text wx:if="{{item.score||item.rating}}"> / 5 ★</text></view><view class="meal-note">{{item.note}}</view></view><view class="meal-edit" data-id="{{item.id}}" bindtap="editMeal">修改</view></view></view><view class="meal-editor" wx:if="{{editing}}"><view class="meal-editor-head"><text>记录一次用餐</text><text class="linkbtn" bindtap="cancelEdit">取消</text></view><view class="rating-field">我的评分</view><view class="star-rating"><view class="star" wx:for="{{stars}}" wx:key="*this"><text class="outline">☆</text><view class="fill" style="width:{{score>=item?100:score>=item-0.5?50:0}}%">★</view><view class="half left" data-value="{{item-0.5}}" bindtap="rate"/><view class="half right" data-value="{{item}}" bindtap="rate"/></view></view><view class="rating-caption"><text>{{score?score+' 星':'轻点打分，支持半星（可不打）'}}</text><text bindtap="clearRating">清除评分</text></view><view class="form-label">用餐日期</view><picker mode="date" value="{{date}}" bindchange="dateChange"><view class="field">{{date||'选择日期（可不填）'}}</view></picker><view class="form-label">用餐笔记</view><textarea class="field" value="{{note}}" bindinput="noteChange" placeholder="记下这一餐的味道、细节与心情" maxlength="2000"/><view class="visit-feedback">保存后会标记为“去过”，并出现在我的美食护照中。</view><view class="visit-actions"><text class="linkbtn" bindtap="deleteMeal" wx:if="{{meals.length}}">删除这次记录</text><view class="btn primary" bindtap="save">保存用餐记录</view></view></view></view></view><view class="note">只保存在本设备，可在“我的”里导出备份。</view></view></view></view>