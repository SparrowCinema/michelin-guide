<view class="wrap" wx:if="{{restaurant}}"><view class="title">{{restaurant.name}}</view><view class="sub">{{restaurant.rating}} · {{restaurant.city}} · {{restaurant.country}}</view><view class="card" bindtap="copyAddress">{{restaurant.address}}<view class="sub">点击复制地址</view></view><view class="sub">{{restaurant.cuisine}} · 价格等级 {{restaurant.priceLevel}}（非具体人均）</view><view class="card" wx:for="{{restaurant.price}}" wx:key="source"><view>{{item.meal}} {{item.currency}} {{item.min}}—{{item.max}}</view><view class="sub">{{item.basis}} · {{item.includes}} · 核验 {{item.checked}}</view></view><button class="btn" bindtap="want">{{wanted?"取消想去":"加入想去"}}</button><button class="btn" bindtap="been">{{visited?"取消去过":"标记去过"}}</button><picker range="{{tripNames}}" bindchange="addTrip"><view class="card">加入旅行 ▾</view></picker><view class="paper"><view class="sub">PRIVATE DINING RECORD · 私人用餐记录</view><view class="stars"><view class="star" wx:for="{{stars}}" wx:key="*this"><text class="outline">☆</text><view class="fill" style="width:{{score >= item ? 100 : score >= item - 0.5 ? 50 : 0}}%">★</view><view class="half left" data-value="{{item - 0.5}}" bindtap="rate"/><view class="half right" data-value="{{item}}" bindtap="rate"/></view></view><view class="row"><text>{{score ? score + ' / 5' : '尚未评分'}}</text><text bindtap="clearRating">清除评分</text></view><picker mode="date" value="{{date}}" bindchange="dateChange"><view class="field">用餐日期：{{date || '选择日期'}}</view></picker><textarea class="field" placeholder="私人用餐笔记" value="{{note}}" bindinput="noteChange" maxlength="2000"/><button class="btn" bindtap="save">保存用餐记录</button></view></view>