<view class="wrap"><view class="title">旅行美食地图</view><picker range="{{tripNames}}" bindchange="selectTrip"><view class="field">当前旅行：{{selectedName||"请先在「我的」创建旅行"}} ▾</view></picker><view class="sub">仅展示当前旅行加入的餐厅，不加载全球餐厅地图。</view><map style="width:100%;height:58vh;border-radius:16rpx" latitude="{{lat}}" longitude="{{lng}}" scale="{{scale}}" markers="{{markers}}" bindmarkertap="markerTap" show-location="{{false}}"/><view class="card" wx:for="{{places}}" wx:key="id" data-id="{{item.id}}" bindtap="open">{{item.name}} · {{item.city}}</view></view>